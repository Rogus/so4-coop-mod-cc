# so4coop kbpad: lets the logged-in user read the keyboard, to use it as a 4th controller.
# When keyd is running, the keys come out of "keyd virtual keyboard" (keyd grabs the physical Telink keyboard, 248a:16ab).
# Install: sudo install -m644 70-so4kbpad.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger --action=add --subsystem-match=input
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", ENV{ID_VENDOR_ID}=="248a", ENV{ID_MODEL_ID}=="16ab", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="keyd virtual keyboard", TAG+="uaccess"
